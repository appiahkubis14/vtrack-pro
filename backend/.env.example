# ===================== APP =====================
NODE_ENV=development
PORT=3000
APP_NAME=V-Track Pro
API_PREFIX=api
CORS_ORIGIN=http://localhost:8080

# ===================== DATABASE (PostgreSQL + PostGIS) =====================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=vtrack
DB_PASSWORD=vtrack123
DB_DATABASE=vtrack
DATABASE_URL=postgresql://vtrack:vtrack123@postgres:5432/vtrack

# ===================== TIMESCALEDB (positions) =====================
TS_HOST=timescale
TS_PORT=5432
TS_USERNAME=vtrack
TS_PASSWORD=vtrack123
TS_DATABASE=vtrack_ts
TIMESCALE_URL=postgresql://vtrack:vtrack123@timescale:5432/vtrack_ts

# ===================== REDIS =====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================== MQTT =====================
MQTT_BROKER_URL=mqtt://mqtt:1883
MQTT_CLIENT_ID=vtrack-backend

# ===================== GPS DEVICE TCP PORTS =====================
GT06_PORT=5023
TK103_PORT=5040
TELTONIKA_PORT=5050

# ===================== AUTH / JWT =====================
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
TWO_FACTOR_APP_NAME=V-Track Pro

# ===================== FIELD ENCRYPTION (business layer) =====================
# AES-256-GCM key for Ghana Card numbers and mobile money numbers: 64 hex characters (32 bytes).
# Generate with:  openssl rand -hex 32
# REQUIRED in production (the app refuses to start without it). Keep it in a secret store and back it up:
# data encrypted with a lost key cannot be recovered.
FIELD_ENCRYPTION_KEY=

# ===================== SETTLEMENT =====================
# When true, every assigned rider's day is calculated automatically at 23:30 Africa/Accra.
# Leave false until the client has confirmed the deduction order and amounts.
AUTO_SETTLEMENT=false

# ===================== EMAIL =====================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@vtrack.local

# ===================== SMS =====================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# ===================== PUSH =====================
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ===================== MESSAGING INTEGRATIONS =====================
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# ===================== RATE LIMITING =====================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ===================== BILLING (optional) =====================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Live map (see docs/map.md) ----
MAP_REFRESH_SECONDS=30          # default refresh rate; each user can change it on the map
MAP_OFFLINE_MINUTES=10          # no GPS fix for this long = offline
GEOCODER_URL=https://nominatim.openstreetmap.org   # address search; the public service is for light use only
GEOCODER_COUNTRY=gh             # limits search to this country (ISO code)
GEOCODER_CONTACT=               # your email or site, sent in the User-Agent as OpenStreetMap requires
ROUTING_URL=                    # OSRM server for ETA; empty = public demo server (testing only)
MAP_TRAFFIC_TILE_URL=           # traffic tiles, e.g. TomTom: https://api.tomtom.com/traffic/map/4/tile/flow/relative0/{z}/{x}/{y}.png?key=YOUR_KEY
MAP_TRAFFIC_ATTRIBUTION=
MAP_WEATHER_TILE_URL=           # optional; empty = free RainViewer radar
MAP_WEATHER_ATTRIBUTION=

# --- advanced map (see docs/map.md) ---
TELEMETRY_INGEST_KEY=            # 16+ characters; opens POST /api/map/ingest/telemetry and /assets/:id for your tracker gateway
CUSTOMER_NOTIFY_WEBHOOK_URL=     # receives delivery ETA messages as JSON; connect to SMS/WhatsApp
CUSTOMER_NOTIFY_WEBHOOK_TOKEN=
MAP_SNAP_LIVE=true               # false = do not snap live positions to roads
MAP_REMOTE_KM=15                 # farther than this from a hub = "remote" for breakdown risk
GRID_CO2_KG_PER_KWH=0.4          # CO2 of electricity, for route comparison
DISPATCH_WATCHER=on              # off = stop the per-minute ETA/route check
