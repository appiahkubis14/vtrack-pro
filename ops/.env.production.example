# Copy to ops/.env.production and fill in EVERY value. Never commit the filled-in file.
# Generate secrets with:  openssl rand -hex 32     (database passwords: openssl rand -base64 24)
DOMAIN=track.example.com.gh

NODE_ENV=production
PORT=3000
API_PREFIX=api
CORS_ORIGIN=https://track.example.com.gh

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=vtrack
DB_PASSWORD=
DB_DATABASE=vtrack

TS_HOST=timescale
TS_PORT=5432
TS_USERNAME=vtrack
TS_PASSWORD=
TS_DATABASE=vtrack_ts

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MQTT_BROKER_URL=mqtt://mqtt:1883
MQTT_CLIENT_ID=vtrack-backend

# two different random values of at least 32 characters
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 64 hex characters. BACK THIS UP SEPARATELY: encrypted Ghana Card and mobile money numbers cannot be read without it.
FIELD_ENCRYPTION_KEY=

# the automatic nightly settlement (set to false to calculate days by hand only)
AUTO_SETTLEMENT=true

# backups: a file holding the passphrase (chmod 600), where dumps are kept, and an optional second location
BACKUP_PASSPHRASE_FILE=/etc/vtrack/backup.pass
BACKUP_HOST_DIR=/var/backups/vtrack
OFFSITE_DIR=
RETENTION_DAYS=14

# Live map (docs/map.md)
GEOCODER_URL=
GEOCODER_CONTACT=
ROUTING_URL=
MAP_TRAFFIC_TILE_URL=
MAP_TRAFFIC_ATTRIBUTION=

# --- advanced map (see docs/map.md) ---
TELEMETRY_INGEST_KEY=            # 16+ characters; opens POST /api/map/ingest/telemetry and /assets/:id for your tracker gateway
CUSTOMER_NOTIFY_WEBHOOK_URL=     # receives delivery ETA messages as JSON; connect to SMS/WhatsApp
CUSTOMER_NOTIFY_WEBHOOK_TOKEN=
MAP_SNAP_LIVE=true               # false = do not snap live positions to roads
MAP_REMOTE_KM=15                 # farther than this from a hub = "remote" for breakdown risk
GRID_CO2_KG_PER_KWH=0.4          # CO2 of electricity, for route comparison
DISPATCH_WATCHER=on              # off = stop the per-minute ETA/route check
