# Automatic HTTPS (Let's Encrypt). {$DOMAIN} is set in ops/.env.production.
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# the API and the live-update socket
	@api path /api/* /health /socket.io/*
	reverse_proxy @api api:3000

	# the website
	handle {
		root * /srv/frontend
		try_files {path} /app/login.html
		file_server
	}
}
